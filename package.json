{
  "name": "covibe",
  "version": "0.1.0",
  "description": "Multi-agent coding studio: YAML-defined agent teams with enforced review and test loops, on top of the Claude Agent SDK.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "covibe": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.302",
    "ajv": "8.17.1",
    "jsonata": "2.1.0",
    "picomatch": "4.0.3",
    "yaml": "2.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/picomatch": "4.0.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
