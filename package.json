{
  "name": "covibe",
  "version": "0.1.0",
  "description": "Multi-agent coding studio: YAML-defined agent teams with enforced review and test loops, on top of the Claude Agent SDK.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "covibe": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config ui/vite.config.ts",
    "build:engine": "tsc -p tsconfig.build.json",
    "build:ui": "vite build --config ui/vite.config.ts",
    "prepare": "npm run build",
    "dev": "tsx src/cli.ts",
    "dev:server": "tsx src/cli.ts app --port 4317 --no-open",
    "dev:ui": "vite --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
    "test": "vitest run",
    "desktop": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.302",
    "@anthropic-ai/sandbox-runtime": "0.0.79",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.17.1",
    "jsonata": "2.1.0",
    "picomatch": "4.0.3",
    "playwright-core": "1.63.0",
    "yaml": "2.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource/pixelify-sans": "5.3.0",
    "@types/node": "22.18.0",
    "@types/picomatch": "4.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.2",
    "codemirror": "6.0.2",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.4"
  },
  "main": "desktop/main.mjs",
  "productName": "covibe",
  "author": "covibe contributors",
  "build": {
    "appId": "dev.covibe.app",
    "productName": "covibe",
    "copyright": "covibe contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-ui/**",
      "desktop/**",
      "schemas/**",
      "examples/**",
      "package.json",
      "LICENSE"
    ],
    "asar": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "covibe turns what you say into the mic button into text for your goals and chats."
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "covibe"
    }
  }
}
