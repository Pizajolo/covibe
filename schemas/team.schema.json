{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covibe.dev/schemas/team.schema.json",
  "title": "covibe team",
  "description": "A team of role agents and the workflow that drives them. Authored as YAML, validated as JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "agents",
    "workflow"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "name": {
      "$ref": "#/$defs/identifier"
    },
    "description": {
      "type": "string"
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "agents": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/agent"
      }
    },
    "workflow": {
      "$ref": "#/$defs/workflow"
    },
    "lead": {
      "description": "The member others ask first when they need a decision. If it cannot answer, the question goes to the human and the run pauses until they reply. Defaults to an agent named manager; null sends questions straight to the human.",
      "anyOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "brain": {
      "type": "object",
      "additionalProperties": false,
      "description": "The project brain: shared notes every member reads. Members propose additions; only the curator writes.",
      "properties": {
        "curator": {
          "$ref": "#/$defs/identifier",
          "description": "The member who reviews proposals and maintains the notes."
        },
        "curate": {
          "enum": [
            "after_run",
            "manual"
          ],
          "description": "after_run (default): the curator reviews new proposals when a run ends. manual: only when you ask."
        },
        "min_proposals": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "With curate: after_run, the curator reviews once at least this many proposals are waiting (default 1). Higher batches reviews and saves tokens."
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "expression": {
      "type": "string",
      "minLength": 1,
      "description": "A JSONata expression evaluated by the engine against the run context (step outputs keyed by step id, plus goal, loop and feedback)."
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "subscription",
            "api_key",
            "gateway",
            "bedrock",
            "vertex",
            "connection"
          ]
        },
        "account": {
          "$ref": "#/$defs/identifier",
          "description": "subscription: a Claude account from Settings → Advanced. Unset (or main) = your own claude login."
        },
        "connection": {
          "$ref": "#/$defs/identifier",
          "description": "connection: a provider from Settings → Advanced (Anthropic-compatible, or OpenAI-compatible through covibe's translator)."
        },
        "base_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "api_key_env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "auth_token_env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "region": {
          "type": "string"
        },
        "project": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "type": {
                "const": "gateway"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "base_url"
            ]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "type": {
                "const": "connection"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "connection",
              "model"
            ]
          }
        }
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "timeout_min": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1440
        },
        "max_budget_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "$ref": "#/$defs/backend"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "$ref": "#/$defs/effort"
        },
        "thinking": {
          "$ref": "#/$defs/thinking"
        },
        "isolation": {
          "enum": [
            "worktree",
            "none"
          ]
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "setting_sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "user",
              "project",
              "local"
            ]
          }
        },
        "sandbox": {
          "$ref": "#/$defs/sandbox"
        },
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:_-]{0,127}$"
          },
          "description": "Skills by name: from your covibe skill library, or ones Claude Code already has (built-in or in the project's .claude/skills)."
        },
        "plugins": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "description": "Plugins by name, from your covibe plugin library. Their hooks, MCP and LSP servers and monitors run in the OS sandbox with the permissions approved for each plugin."
        },
        "browser": {
          "type": "boolean",
          "description": "Give the member covibe's browser: tools to open pages (a dev server, a site, or files in its working folder), read them as snapshots, click, type, take screenshots and read the console. People can watch it live in the app and take control. Default false."
        },
        "cache_ttl": {
          "enum": [
            "5m",
            "1h"
          ],
          "description": "How long Claude keeps this member's prompt cache. Unset: Claude Code decides (1 hour on a subscription, 5 minutes on an API key). 1h costs more per cache write but keeps a resumed member's conversation cached across long waits such as a review between fix rounds. Only applies to Anthropic's API."
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "tools"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "description": "Path to a Markdown file (relative to the team file) or, if it contains a newline, the prompt text itself."
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "$ref": "#/$defs/effort"
        },
        "thinking": {
          "$ref": "#/$defs/thinking"
        },
        "tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "can_message": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "can_request": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "description": "Teammates this agent may ask to do work for it with the request_work tool. The teammate runs a turn of its own (even if it has no workflow step), its changes are merged, and its reply comes back as the tool's answer."
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "write": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Globs (relative to the repository root) this agent may write. Omit to allow the whole worktree; [] allows nothing."
            }
          }
        },
        "output_schema": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "$ref": "#/$defs/backend"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "sandbox": {
          "$ref": "#/$defs/sandbox"
        },
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:_-]{0,127}$"
          },
          "description": "Skills by name: from your covibe skill library, or ones Claude Code already has (built-in or in the project's .claude/skills)."
        },
        "plugins": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "description": "Plugins by name, from your covibe plugin library. Their hooks, MCP and LSP servers and monitors run in the OS sandbox with the permissions approved for each plugin."
        },
        "browser": {
          "type": "boolean",
          "description": "Give the member covibe's browser: tools to open pages (a dev server, a site, or files in its working folder), read them as snapshots, click, type, take screenshots and read the console. People can watch it live in the app and take control. Default false."
        },
        "cache_ttl": {
          "enum": [
            "5m",
            "1h"
          ],
          "description": "How long Claude keeps this member's prompt cache. Unset: Claude Code decides (1 hour on a subscription, 5 minutes on an API key). 1h costs more per cache write but keeps a resumed member's conversation cached across long waits such as a review between fix rounds. Only applies to Anthropic's API."
        }
      }
    },
    "gateFailPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goto",
        "max_loops"
      ],
      "properties": {
        "goto": {
          "$ref": "#/$defs/identifier"
        },
        "max_loops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "feed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expression"
          }
        },
        "then": {
          "enum": [
            "escalate_to_human",
            "fail"
          ]
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent"
      ],
      "properties": {
        "agent": {
          "$ref": "#/$defs/identifier"
        },
        "task": {
          "$ref": "#/$defs/expression"
        },
        "output_schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agentStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "agent"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "agent": {
          "$ref": "#/$defs/identifier"
        },
        "task": {
          "$ref": "#/$defs/expression"
        },
        "instructions": {
          "type": "string"
        },
        "output_schema": {
          "type": "string",
          "minLength": 1
        },
        "gate": {
          "$ref": "#/$defs/expression"
        },
        "on_gate_fail": {
          "$ref": "#/$defs/gateFailPolicy"
        }
      }
    },
    "parallelStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parallel"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "parallel": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/branch"
          }
        },
        "instructions": {
          "type": "string"
        },
        "gate": {
          "$ref": "#/$defs/expression"
        },
        "on_gate_fail": {
          "$ref": "#/$defs/gateFailPolicy"
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "on_gate_fail": {
          "$ref": "#/$defs/gateFailPolicy"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "if": {
              "type": "object",
              "required": [
                "parallel"
              ]
            },
            "then": {
              "$ref": "#/$defs/parallelStep"
            },
            "else": {
              "$ref": "#/$defs/agentStep"
            }
          }
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "description": "Run the member's shell commands in an OS sandbox (Seatbelt on macOS, bubblewrap on Linux): writes only inside its worktree, temp folders and allow_write; network only to the listed domains.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "network": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(\\*\\.)?[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)*(:[0-9]{1,5})?$"
          },
          "description": "Domains shell commands may reach, e.g. registry.npmjs.org or *.github.com."
        },
        "allow_write": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(~|/)"
          },
          "description": "Extra folders shell commands may write, e.g. ~/.npm. Absolute or starting with ~."
        }
      }
    },
    "effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "description": "How much effort Claude puts into each answer (thinking, care, length). Models support different levels; an unsupported level falls back to the closest one."
    },
    "thinking": {
      "anyOf": [
        {
          "enum": [
            "adaptive",
            "off"
          ]
        },
        {
          "type": "integer",
          "minimum": 1024,
          "maximum": 128000
        }
      ],
      "description": "Extended thinking: adaptive (Claude decides when and how much), off, or a fixed token budget (older models)."
    }
  }
}
