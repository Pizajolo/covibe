{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "tasks"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "enum": [
          "frontend",
          "backend",
          "qa",
          "tester"
        ]
      },
      "description": "The members this goal needs after the plan. Steps of the others are skipped; members you give a task to always run."
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "title",
          "description",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "owner": {
            "enum": [
              "frontend",
              "backend"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Files to change or read first, so the owner does not have to search for them."
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
