{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "build report",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "files_changed"],
  "properties": {
    "status": { "enum": ["done", "partial", "blocked"] },
    "summary": { "type": "string" },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  }
}
